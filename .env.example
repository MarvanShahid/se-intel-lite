# Copy to .env (never commit .env). Loaded by your shell / IDE; the code reads plain environment variables.

# Anthropic API key (or run `ant auth login` once instead; the SDK picks up the profile automatically)
ANTHROPIC_API_KEY=

# Agent / baseline model and the fixed judge model (provider:model)
SEINTEL_LLM=anthropic:claude-opus-5-5
SEINTEL_JUDGE=anthropic:claude-opus-5-5
# Thinking effort for the agent LLM: low | medium | high | xhigh | max
SEINTEL_EFFORT=medium

# Optional: any OpenAI-compatible endpoint for --llm openai:<model> (not used for the reported results)
OPENAI_API_KEY=
OPENAI_BASE_URL=
